# Copy to .env and fill in. Secrets only — everything else lives in config.yaml.
{% if include_database %}

# Postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/{{ project_slug | replace('-', '_') }}
{% endif %}
{% if include_worker %}

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost/
{% endif %}
{% if include_cache %}

# Redis
REDIS_URL=redis://localhost:6379/0
{% endif %}
{% if include_auth %}

# Auth — mix this into every API key's hash. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be changed before any non-local deployment.
API_KEY_SALT=change-me-in-production
{% endif %}
{% if include_ai_service %}

# LLM provider — only the block matching ai.llm.provider in config.yaml is required.
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
{% endif %}
{% if include_observability %}

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
{% endif %}
