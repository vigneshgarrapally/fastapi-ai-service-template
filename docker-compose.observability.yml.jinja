# Optional overlay — Grafana + Prometheus for local/self-hosted metrics.
#
#   docker compose -f docker-compose.yml -f docker-compose.observability.yml up -d
#
# Langfuse (LLM tracing) and OTel (distributed tracing) are external services
# configured via .env — nothing to run locally for those; this overlay is only
# for the Prometheus/Grafana metrics half of the observability component.
services:
  prometheus:
    image: prom/prometheus:latest
    restart: unless-stopped
    networks: [app]
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
    ports:
      - "${PROMETHEUS_PORT:-9090}:9090"

  grafana:
    image: grafana/grafana:latest
    restart: unless-stopped
    networks: [app]
    volumes:
      - ./grafana/datasources:/etc/grafana/provisioning/datasources:ro
      - ./grafana/dashboards:/etc/grafana/provisioning/dashboards:ro
      - ./grafana/dashboards/json:/var/lib/grafana/dashboards:ro
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD:-admin}
    ports:
      - "${GRAFANA_PORT:-3001}:3000"
    depends_on:
      - prometheus
