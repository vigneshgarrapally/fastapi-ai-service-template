    """Async job runtime: RabbitMQ prefetch, retries, idempotency TTL."""

    prefetch: int = Field(default=5, gt=0)
    max_retries: int = Field(default=3, ge=0)
    idem_ttl_hours: int = Field(default=24, gt=0)
    idem_cleanup_interval_seconds: int = Field(default=3600, gt=0)
{% endif %}
{% if include_cache %}

class CacheConfig(BaseModel):
    """Redis cache defaults."""

    default_ttl_seconds: int = Field(default=3600, gt=0)
{% endif %}
{% if include_observability %}

class ObservabilityConfig(BaseModel):
    """Non-secret observability config (secret keys live in :class:`Secrets`).

    Attributes:
        langfuse_host: Langfuse server URL (cloud or self-hosted).
        otel_endpoint: OTLP gRPC endpoint (e.g. ``tempo:4317``). Empty disables tracing.
