    otel_endpoint: str = ""
    otel_service_name: str = ""
{% endif %}
{% if include_ai_service %}

class AIServiceConfig(BaseModel):
    """AI/agent service: LLM provider + call tuning.

    Attributes:
        llm: Nested LLM provider settings (provider + per-provider config).
        temperature: Sampling temperature for the conversational agent.
        max_history_messages: How many prior turns to keep in the session's memory.
    """

    llm: LLMSettings = LLMSettings()
    temperature: float = Field(default=0.3, ge=0.0, le=2.0)
    max_history_messages: int = Field(default=20, gt=0)
{% endif %}


# ---------------------------------------------------------------------------
# Top-level settings
# ---------------------------------------------------------------------------
class Settings(BaseSettings):
    """Typed, validated settings for {{ project_name }}.

    Non-secret groups are populated from ``config.yaml`` (path overridable via the
    ``CONFIG_FILE`` env var). Any individual non-secret value can be overridden with
    an environment variable using the ``__`` nested delimiter. Secrets are loaded
    separately from the environment / ``.env`` via :class:`Secrets`.
    """

    model_config = SettingsConfigDict(
        env_nested_delimiter="__",
        env_file=".env",
        env_file_encoding="utf-8",
        yaml_file=_config_file(),
        yaml_file_encoding="utf-8",
        case_sensitive=False,
        extra="ignore",
    )

    app: AppConfig = AppConfig()
{% if include_database %}
    database: DatabaseConfig = DatabaseConfig()
{% endif %}
{% if include_worker %}
    worker: WorkerConfig = WorkerConfig()
{% endif %}
{% if include_cache %}
    cache: CacheConfig = CacheConfig()
{% endif %}
{% if include_observability %}
    observability: ObservabilityConfig = ObservabilityConfig()
{% endif %}
{% if include_ai_service %}
    ai: AIServiceConfig = AIServiceConfig()
{% endif %}
    secrets: Secrets = Field(default_factory=Secrets)

    @classmethod
    def settings_customise_sources(
        cls,
        settings_cls: type[BaseSettings],
        init_settings: PydanticBaseSettingsSource,
        env_settings: PydanticBaseSettingsSource,
        dotenv_settings: PydanticBaseSettingsSource,
        file_secret_settings: PydanticBaseSettingsSource,
    ) -> tuple[PydanticBaseSettingsSource, ...]:
        """Add the yaml source. Precedence (highest first): init -> env -> .env -> yaml."""
        return (
            init_settings,
            env_settings,
            dotenv_settings,
            YamlConfigSettingsSource(settings_cls),
        )


@lru_cache
def get_settings() -> Settings:
    """Return the application settings singleton.

    Constructed once and cached via ``@lru_cache``; safe to call from anywhere.

    Raises:
        FileNotFoundError: If the configured ``config.yaml`` does not exist. We fail
            fast rather than silently fall back to defaults for a missing config file.

    Note:
        In tests, call ``get_settings.cache_clear()`` before injecting a custom
        environment to force re-construction.
    """
    config_path = Path(_config_file())
    if not config_path.is_file():
        raise FileNotFoundError(
            f"Config file not found: {config_path!s}. Set CONFIG_FILE or create "
            "config.yaml at the repo root. (Secrets still come from .env.)"
        )
    return Settings()
