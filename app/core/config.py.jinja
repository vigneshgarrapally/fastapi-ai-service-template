"""Application settings — single source of truth for all configuration.

Configuration is split in two:

* **Secrets** (API keys, connection strings, salts) live **only** in the environment /
  ``.env`` file, loaded by :class:`Secrets` using flat env names (e.g. ``DATABASE_URL``).
* **Everything else** (pool sizes, timeouts, provider choice) lives in a committed
  **``config.yaml``**, grouped by area. These groups map to nested sub-models on
  :class:`Settings`.

Source precedence (highest wins)::

    environment variable  ->  .env file  ->  config.yaml  ->  field default

Any non-secret value can be overridden per-environment with an environment variable
using the ``__`` nested delimiter, e.g. ``DATABASE__POOL_SIZE=20``.

Usage::

    from app.core.config import get_settings

    settings = get_settings()                 # cached singleton — call anywhere
    print(settings.secrets.database_url)      # secret, from env/.env
{% if include_database %}
    print(settings.database.pool_size)        # non-secret, from config.yaml
{% endif %}
"""

from __future__ import annotations

import os
from functools import lru_cache
from pathlib import Path
from typing import Literal

from pydantic import BaseModel, Field
from pydantic_settings import (
    BaseSettings,
    PydanticBaseSettingsSource,
    SettingsConfigDict,
    YamlConfigSettingsSource,
)
{% if include_ai_service %}

from app.llm.config import LLMSettings
{% endif %}


def _config_file() -> str:
    """Resolve the yaml config path (``CONFIG_FILE`` env var or default)."""
    return os.getenv("CONFIG_FILE", "config.yaml")


# ---------------------------------------------------------------------------
# Secrets — env / .env only, flat names, never in config.yaml
# ---------------------------------------------------------------------------
class Secrets(BaseSettings):
    """Sensitive values. Loaded exclusively from the environment / ``.env``.

    Empty defaults keep optional integrations silently disabled and let required
    ones surface their own errors downstream, instead of failing at import time.
    """

    model_config = SettingsConfigDict(
        env_file=".env",
        env_file_encoding="utf-8",
        case_sensitive=False,
        extra="ignore",
    )

{% if include_database %}
    database_url: str = "postgresql+asyncpg://postgres:postgres@localhost:5432/{{ project_slug | replace('-', '_') }}"
{% endif %}
{% if include_worker %}
    rabbitmq_url: str = "amqp://guest:guest@localhost/"
{% endif %}
{% if include_cache %}
    redis_url: str = "redis://localhost:6379/0"
{% endif %}
{% if include_auth %}
    api_key_salt: str = "change-me-in-production"
{% endif %}
{% if include_ai_service %}
    openai_api_key: str = ""
    azure_openai_api_key: str = ""
{% endif %}
{% if include_observability %}
    langfuse_public_key: str = ""
    langfuse_secret_key: str = ""
{% endif %}


# ---------------------------------------------------------------------------
# Non-secret config groups — loaded from config.yaml
# ---------------------------------------------------------------------------
class AppConfig(BaseModel):
    """App metadata, server, CORS, and logging.

    Attributes:
        app_name: Human-readable service name surfaced in FastAPI docs and logs.
        app_version: Semver string exposed in the OpenAPI schema.
        environment: Deployment tier. Controls log format{% if include_backend %} and disables
            ``/docs``/``/redoc`` in production{% endif %}.
        debug: When ``True``, forces ``log_level`` to DEBUG.
{% if include_backend %}
        host: Bind address for the Uvicorn server.
        port: Listen port.
        allowed_origins: CORS allowed-origins list. Use ``["*"]`` only in dev.
        public_base_url: Optional explicit base URL for the Scalar API
            reference's built-in "Test Request" client (the OpenAPI ``servers``
            entry). Leave empty (the default) to let Scalar target the origin
            the browser loaded ``/scalar`` from. Set it only when the public
            URL differs from the browser origin (reverse proxy, custom domain).
{% endif %}
        log_level: Minimum log level.
    """

    app_name: str = "{{ project_name }}"
    app_version: str = "0.1.0"
    environment: str = Field(
        default="development", pattern="^(development|local|staging|production)$"
    )
    debug: bool = False
{% if include_backend %}

    host: str = "0.0.0.0"
    port: int = 8000
    allowed_origins: list[str] = ["*"]
    public_base_url: str = ""
{% endif %}

    log_level: Literal["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"] = "INFO"

{% if include_database %}

class DatabaseConfig(BaseModel):
    """SQLAlchemy async engine connection pool sizing."""

    pool_size: int = Field(default=10, gt=0)
    max_overflow: int = Field(default=20, ge=0)
{% endif %}
{% if include_worker %}

