# Development overrides — merged automatically by Docker Compose when present.
#
#   Dev mode  ->  docker compose up -d --build          (this file applies automatically)
#   Prod mode ->  docker compose -f docker-compose.yml up -d --build   (override ignored)
#
# Mounts source code into the containers and runs with hot reload / auto-restart.
services:
{% if include_backend %}

  fastapi:
    command: ["uv", "run", "uvicorn", "app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"]
    volumes:
      - ./app:/app/app
    environment:
      - APP__ENVIRONMENT=local
      - APP__DEBUG=true
{% endif %}
{% if include_worker %}

  worker:
    command: >
      uv run --no-dev watchfiles --filter python
      "uv run --no-dev python -m app.worker.main"
      ./app
    volumes:
      - ./app:/app/app
    environment:
      - APP__ENVIRONMENT=local
      - APP__DEBUG=true
{% endif %}
