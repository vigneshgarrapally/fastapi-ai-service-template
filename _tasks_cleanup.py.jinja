if not include_auth:
    rm("app", "core", "auth.py")
    rm("app", "db", "models", "api_key.py")
    rm("app", "db", "repositories", "api_keys.py")
    rm("tests", "core", "test_auth.py")
    rm("tests", "db", "repositories", "test_api_keys.py")
    rm("scripts", "manage_api_keys.py")

if not include_ai_service:
    rm("app", "features", "ai")
    rm("app", "llm")
    rm("app", "api", "v1", "endpoints", "chat.py")
    rm("app", "worker", "ai_job_worker.py")
    rm("evals")
    rm("tests", "features", "ai")
    rm("tests", "llm")
    rm("tests", "api", "v1", "test_chat.py")

# Remove now-empty leftover directories (e.g. app/api/v1/endpoints with nothing left).
for dirpath in sorted(root.rglob("*"), key=lambda p: len(p.parts), reverse=True):
    if dirpath.is_dir() and not any(dirpath.iterdir()):
        # .gitkeep-guarded empty dirs are intentional (e.g. alembic/versions); leave those.
        dirpath.rmdir()
